# ============================================
# TRADUTOR DE RAÇÃO - Configuração do Backend
# ============================================
# COPIE este arquivo para .env e preencha os valores reais.
# NUNCA commit o .env real no repositório!

# Porta do servidor (padrão: 3001)
PORT=3001

# Ambiente (development | production)
NODE_ENV=development

# Origens permitidas pelo CORS (separadas por vírgula)
# Em produção, use apenas o domínio real do seu site
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Chave da API do Google Gemini (obrigatória para análise por IA)
# Obtenha em: https://aistudio.google.com/apikey
GEMINI_API_KEY=SUA_CHAVE_AQUI

# Tamanho máximo do upload de imagem em bytes (padrão: 3MB)
MAX_FILE_SIZE=3145728

# Requisições máximas por IP a cada 15 minutos
RATE_LIMIT_MAX=30

# ============================================
# PAGAMENTOS (MERCADO PAGO PIX)
# ============================================
# Obtenha em: https://www.mercadopago.com.br/developers/panel/app
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-SEU_ACCESS_TOKEN_AQUI
PIX_ANALYSIS_PRICE=4.90
