{
  "version": 2,
  "redirects": [
    {
      "source": "/backend/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/.git/(.*)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/.env(.*)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/(.*)\\.(md|pdf|cjs|json|env.*|log|lock|yml|yaml)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/relatorio_retomada.html",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  }
}
